# =====================================================
# AMINOVITA - .gitignore
# Archivos y carpetas que NO se suben a GitHub
# =====================================================


# ── SECRETOS (¡Lo más importante!) ────────────────
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local
.env.production


# ── DEPENDENCIAS (Muy pesadas) ────────────────────
node_modules/
**/node_modules/


# ── LOGS ──────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ── SISTEMA OPERATIVO ─────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini


# ── EDITORES DE CÓDIGO ────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# ── BUILD / DIST ──────────────────────────────────
dist/
build/
